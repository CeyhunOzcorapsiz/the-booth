# Model provider for the agent crew: offline | foundry | github | openai
# offline needs no keys: agents use deterministic templates.
BOOTH_LLM=offline

# Microsoft Foundry / Azure OpenAI (OpenAI v1 endpoint)
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-4.1-mini

# GitHub Models (free tier, rate limited). Token needs the "Models: read" permission.
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

# Any other OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Budget and resilience
BOOTH_LLM_MIN_IMPORTANCE=0.5
BOOTH_LLM_CONCURRENCY=2
BOOTH_LLM_TIMEOUT=12
BOOTH_LLM_DAILY_BUDGET=1500

# Azure AI Speech neural voices (optional, free F0 tier). Without it the browser voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
BOOTH_SPEECH_DAILY_CHARS=15000

# Public deployment protection
BOOTH_MAX_STREAMS=20
BOOTH_MAX_STREAMS_PER_CLIENT=2
BOOTH_REQUESTS_PER_MINUTE=30
# true only behind a proxy you trust (Azure Container Apps ingress)
BOOTH_TRUST_PROXY=false

# Telemetry (optional): Application Insights or any OTLP collector
APPLICATIONINSIGHTS_CONNECTION_STRING=
