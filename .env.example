# Model provider for the agent crew: offline | foundry | github | openai
# offline needs no keys: agents use deterministic templates.
BOOTH_LLM=offline

# Microsoft Foundry / Azure OpenAI (OpenAI v1 endpoint)
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-4.1-mini

# GitHub Models (free tier, rate limited). Token needs the "Models: read" permission.
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

# Any other OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Budget and resilience
BOOTH_LLM_MIN_IMPORTANCE=0.5
BOOTH_LLM_CONCURRENCY=2
BOOTH_LLM_TIMEOUT=12
